{
  "name": "mindspark-remotion",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "demo": "remotion render src/index.ts Main out/demo.mp4 --props=../data/demo_plan.json",
    "demo:anime": "remotion render src/index.ts Main out/demo_anime.mp4 --props=../data/demo_anime_plan.json",
    "demo:story": "remotion render src/index.ts Main out/story_demo.mp4 --props=../data/demo_plan_story.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.4.0"
  }
}
