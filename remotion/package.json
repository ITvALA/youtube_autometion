{
  "name": "mindspark-remotion",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "demo": "remotion render src/index.ts Main out/demo.mp4 --props=../data/demo_plan.json",
    "demo:anime": "remotion render src/index.ts Main out/demo_anime.mp4 --props=../data/demo_anime_plan.json",
    "demo:vox": "remotion render src/index.ts Main out/demo_vox.mp4 --props=../data/demo_plan_vox.json",
    "demo:story": "remotion render src/index.ts Main out/story_demo.mp4 --props=../data/demo_plan_story.json",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "d3-geo": "^3.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "^5.4.0"
  }
}
